<Page
    x:Class="ViVeToolGUI.Pages.EnableDisablePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:variantControls="using:ViVeToolGUI.Controls"
    xmlns:local="using:ViVeToolGUI.Pages"
    xmlns:tabular="using:Microsoft.UI.Xaml.Controls.Tabular">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="20,20,20,0" Spacing="0">
            <controls:SettingsCard x:Uid="EnableDisable_FeatureIDCard"
                   HorizontalAlignment="Stretch"
                   HorizontalContentAlignment="Stretch"
                   MinHeight="70"
                   Padding="16,0"
                   Margin="0,0,0,5">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xF1AD;" FontSize="28"/>
                </controls:SettingsCard.HeaderIcon>

                <Grid MinWidth="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ValidationText"
                               x:Uid="EnableDisable_InvalidID"
                               Grid.Column="0"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Visibility="Collapsed"/>

                    <TextBox x:Name="FeatureIDTextBox"
                             x:Uid="EnableDisable_FeatureIDBox"
                             Grid.Column="1"
                             TextChanged="FeatureIDTextBox_TextChanged"
                             KeyDown="FeatureIDTextBox_KeyDown"
                             Height="64"
                             MinWidth="128"
                             HorizontalAlignment="Stretch"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"/>
                </Grid>
            </controls:SettingsCard>

            <Rectangle Height="1"
                       Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                       Margin="0,0,0,5"/>

            <variantControls:VariantOptionsControl x:Name="VariantOptions"/>
        </StackPanel>

        <Grid Grid.Row="1" Padding="20,10,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,6">
                <TextBlock x:Uid="History"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button x:Name="ClearHistoryButton"
                        x:Uid="ClearHistoryButton"
                        HorizontalAlignment="Right"
                        Click="ClearHistoryButton_Click"
                        Padding="6,4">
                    <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                </Button>
            </Grid>

            <Border Grid.Row="1"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <tabular:TableView x:Name="HistoryListView"
                                  Grid.Row="1"
                                  IsReadOnly="True">
                        <tabular:TableView.Resources>
                            <Style TargetType="tabular:TableViewRow">
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="ContextFlyout">
                                    <Setter.Value>
                                        <MenuFlyout Opening="HistoryMenuFlyout_Opening">
                                            <MenuFlyoutItem x:Name="MenuHistoryEnable" x:Uid="Menu_EnableFeature" Click="HistoryEnable_Click" CommandParameter="{Binding}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE73E;"/></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="MenuHistoryDisable" x:Uid="Menu_DisableFeature" Click="HistoryDisable_Click" CommandParameter="{Binding}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE711;"/></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Uid="Menu_RestoreFeature" Click="HistoryRestore_Click" CommandParameter="{Binding}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE777;"/></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator/>
                                            <MenuFlyoutItem x:Uid="Menu_CopyFeatureId" Click="HistoryCopyId_Click" CommandParameter="{Binding}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;"/></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Uid="Menu_HistoryDelete" Click="HistoryDelete_Click" CommandParameter="{Binding}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/></MenuFlyoutItem.Icon>
                                                <MenuFlyoutItem.Foreground><StaticResource ResourceKey="SystemFillColorCriticalBrush"/></MenuFlyoutItem.Foreground>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </tabular:TableView.Resources>
                        <tabular:TableViewTemplateColumn x:Name="HistoryTimeColumn" Width="180">
                            <tabular:TableViewTemplateColumn.Header>
                                <TextBlock x:Uid="History_HeaderTime" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </tabular:TableViewTemplateColumn.Header>
                            <tabular:TableViewTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="local:OperationRecord">
                                    <Grid Padding="12,6" VerticalAlignment="Stretch">
                                        <TextBlock Text="{x:Bind Time}" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </tabular:TableViewTemplateColumn.CellTemplate>
                        </tabular:TableViewTemplateColumn>
                        <tabular:TableViewTemplateColumn x:Name="HistoryIdColumn" Width="160">
                            <tabular:TableViewTemplateColumn.Header>
                                <TextBlock x:Uid="Query_HeaderID" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </tabular:TableViewTemplateColumn.Header>
                            <tabular:TableViewTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="local:OperationRecord">
                                    <Grid Padding="12,6" VerticalAlignment="Stretch">
                                        <TextBlock Text="{x:Bind FeatureId}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </tabular:TableViewTemplateColumn.CellTemplate>
                        </tabular:TableViewTemplateColumn>
                        <tabular:TableViewTemplateColumn x:Name="HistoryOperationColumn" Width="160">
                            <tabular:TableViewTemplateColumn.Header>
                                <TextBlock x:Uid="History_HeaderOperation" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </tabular:TableViewTemplateColumn.Header>
                            <tabular:TableViewTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="local:OperationRecord">
                                    <Grid Padding="12,6" VerticalAlignment="Stretch">
                                        <TextBlock Text="{x:Bind Operation}" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </tabular:TableViewTemplateColumn.CellTemplate>
                        </tabular:TableViewTemplateColumn>
                        <tabular:TableViewTemplateColumn x:Name="HistoryVariantColumn" Width="120">
                            <tabular:TableViewTemplateColumn.Header>
                                <TextBlock x:Uid="History_HeaderVariant" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </tabular:TableViewTemplateColumn.Header>
                            <tabular:TableViewTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="local:OperationRecord">
                                    <Grid Padding="12,6" VerticalAlignment="Stretch">
                                        <TextBlock Text="{x:Bind Variant}" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </tabular:TableViewTemplateColumn.CellTemplate>
                        </tabular:TableViewTemplateColumn>
                        <tabular:TableViewTemplateColumn x:Name="HistoryPayloadColumn" Width="*">
                            <tabular:TableViewTemplateColumn.Header>
                                <TextBlock x:Uid="Query_HeaderVariantPayload" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </tabular:TableViewTemplateColumn.Header>
                            <tabular:TableViewTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="local:OperationRecord">
                                    <Grid Padding="12,6" VerticalAlignment="Stretch">
                                        <TextBlock Text="{x:Bind VariantPayload}" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </tabular:TableViewTemplateColumn.CellTemplate>
                        </tabular:TableViewTemplateColumn>
                    </tabular:TableView>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Margin="0,-8,0,0"/>

            <StackPanel Padding="20,10,20,20" Spacing="20">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="EnableButton"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="EnableButton_Click"
                            IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE73E;" FontSize="16"/>
                            <TextBlock x:Uid="EnableDisable_EnableButton"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="DisableButton"
                            Click="DisableButton_Click"
                            IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE711;" FontSize="16"/>
                            <TextBlock x:Uid="EnableDisable_DisableButton"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="RestoreButton"
                            Click="RestoreButton_Click"
                            IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE777;" FontSize="16"/>
                            <TextBlock x:Uid="EnableDisable_RestoreButton"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Page>

<Page
    x:Class="ViVeToolGUI.Pages.EnableDisablePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:ViVeToolGUI.Pages"
    xmlns:tabular="using:Microsoft.UI.Xaml.Controls.Tabular">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="20,20,20,0" Spacing="0">
            <controls:SettingsCard x:Uid="EnableDisable_FeatureIDCard"
                   HorizontalAlignment="Stretch"
                   HorizontalContentAlignment="Stretch"
                   MinHeight="70"
                   Padding="16,0"
                   Margin="0,0,0,5">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xF1AD;" FontSize="28"/>
                </controls:SettingsCard.HeaderIcon>

                <Grid MinWidth="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ValidationText"
                               x:Uid="EnableDisable_InvalidID"
                               Grid.Column="0"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Visibility="Collapsed"/>

                    <TextBox x:Name="FeatureIDTextBox"
                             x:Uid="EnableDisable_FeatureIDBox"
                             Grid.Column="1"
                             TextChanged="FeatureIDTextBox_TextChanged"
                             KeyDown="FeatureIDTextBox_KeyDown"
                             Height="64"
                             MinWidth="128"
                             HorizontalAlignment="Stretch"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"/>
                </Grid>
            </controls:SettingsCard>

            <Rectangle Height="1"
                       Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                       Margin="0,0,0,5"/>

            <Expander HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      MinHeight="70">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xEC7A;" Width="25" FontSize="20"/>
                        <StackPanel Margin="5,0,0,0">
                            <TextBlock x:Uid="EnableDisable_Variant" FontSize="14.4"/>
                            <TextBlock x:Uid="EnableDisable_VariantDescription"
                                       FontSize="12" Opacity="0.8"/>
                        </StackPanel>
                    </StackPanel>
                </Expander.Header>

                <Grid ColumnSpacing="16" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               x:Uid="EnableDisable_Variant"
                               VerticalAlignment="Center" Opacity="0.8"/>

                    <ComboBox x:Name="VariantModeComboBox"
                              Grid.Row="0" Grid.Column="1"
                              Width="150" HorizontalAlignment="Left"
                              SelectionChanged="VariantModeComboBox_SelectionChanged">
                        <ComboBoxItem x:Uid="VariantMode_None" IsSelected="True" Tag="None"/>
                        <ComboBoxItem x:Uid="VariantMode_Custom" Tag="Custom"/>
                    </ComboBox>

                    <TextBlock x:Name="VariantNumberLabel" Grid.Row="1" Grid.Column="0"
                               x:Uid="EnableDisable_VariantNumber"
                               VerticalAlignment="Center" Opacity="0.8"
                               Visibility="Collapsed"/>

                    <StackPanel x:Name="VariantNumberPanel" Grid.Row="1" Grid.Column="1"
                                Orientation="Horizontal" Spacing="8"
                                Visibility="Collapsed">
                        <NumberBox x:Name="VariantNumberBox"
                                   Width="150" HorizontalAlignment="Left"
                                   Minimum="0" Maximum="4294967295"
                                   SpinButtonPlacementMode="Compact"
                                   PlaceholderText="0"/>
                        <ComboBox x:Name="VariantPayloadKindComboBox"
                                  HorizontalAlignment="Left"
                                  SelectionChanged="VariantPayloadKindComboBox_SelectionChanged">
                            <ComboBoxItem x:Uid="VariantPayloadKind_None" IsSelected="True" Tag="None"/>
                            <ComboBoxItem x:Uid="VariantPayloadKind_Resident" Tag="Resident"/>
                            <ComboBoxItem x:Uid="VariantPayloadKind_External" Tag="External"/>
                        </ComboBox>
                    </StackPanel>

                    <TextBlock x:Name="VariantPayloadLabel" Grid.Row="2" Grid.Column="0"
                               x:Uid="EnableDisable_VariantPayload"
                               VerticalAlignment="Center" Opacity="0.8"
                               Visibility="Collapsed"/>

                    <NumberBox x:Name="VariantPayloadNumberBox"
                               Grid.Row="2" Grid.Column="1"
                               Width="150" HorizontalAlignment="Left"
                               Minimum="0" Maximum="4294967295"
                               SpinButtonPlacementMode="Compact"
                               PlaceholderText="0"
                               Visibility="Collapsed"/>
                </Grid>
            </Expander>
        </StackPanel>

        <Grid Grid.Row="1" Padding="20,10,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,6">
                <TextBlock x:Uid="History"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button x:Name="ClearHistoryButton"
                        x:Uid="ClearHistoryButton"
                        HorizontalAlignment="Right"
                        Click="ClearHistoryButton_Click"
                        Padding="6,4">
                    <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                </Button>
            </Grid>

            <Border Grid.Row="1"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <tabular:TableView x:Name="HistoryListView"
                                  Grid.Row="1"
                                  IsReadOnly="True">
                        <tabular:TableView.Resources>
                            <Style TargetType="tabular:TableViewRow">
                                <Setter Property="ContextFlyout">
                                    <Setter.Value>
                                        <MenuFlyout Opening="HistoryMenuFlyout_Opening">
                                            <MenuFlyoutItem x:Name="MenuHistoryEnable" x:Uid="Menu_EnableFeature" Click="HistoryEnable_Click" CommandParameter="{Binding}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE73E;"/></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="MenuHistoryDisable" x:Uid="Menu_DisableFeature" Click="HistoryDisable_Click" CommandParameter="{Binding}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE711;"/></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Uid="Menu_RestoreFeature" Click="HistoryRestore_Click" CommandParameter="{Binding}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE777;"/></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator/>
                                            <MenuFlyoutItem x:Uid="Menu_CopyFeatureId" Click="HistoryCopyId_Click" CommandParameter="{Binding}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;"/></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Uid="Menu_HistoryDelete" Click="HistoryDelete_Click" CommandParameter="{Binding}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/></MenuFlyoutItem.Icon>
                                                <MenuFlyoutItem.Foreground><StaticResource ResourceKey="SystemFillColorCriticalBrush"/></MenuFlyoutItem.Foreground>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </tabular:TableView.Resources>
                        <tabular:TableViewTextColumn x:Name="HistoryTimeColumn" Binding="{Binding Time}" Width="180"/>
                        <tabular:TableViewTextColumn x:Name="HistoryIdColumn" Binding="{Binding FeatureId}" Width="160"/>
                        <tabular:TableViewTextColumn x:Name="HistoryOperationColumn" Binding="{Binding Operation}" Width="*"/>
                    </tabular:TableView>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Margin="0,-8,0,0"/>

            <StackPanel Padding="20,10,20,20" Spacing="20">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="EnableButton"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="EnableButton_Click"
                            IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE73E;" FontSize="16"/>
                            <TextBlock x:Uid="EnableDisable_EnableButton"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="DisableButton"
                            Click="DisableButton_Click"
                            IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE711;" FontSize="16"/>
                            <TextBlock x:Uid="EnableDisable_DisableButton"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="RestoreButton"
                            Click="RestoreButton_Click"
                            IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE777;" FontSize="16"/>
                            <TextBlock x:Uid="EnableDisable_RestoreButton"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Page>

<Page
    x:Class="ViVeToolGUI.AppWindows.Pages.TextFileViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ViVeToolGUI.AppWindows"
    xmlns:tabular="using:Microsoft.UI.Xaml.Controls.Tabular">
    <Grid x:Name="PageRoot">
        <Grid.Resources>
            <Storyboard x:Name="InfoBarSlideIn">
                <DoubleAnimation Storyboard.TargetName="InfoBarTransform" Storyboard.TargetProperty="Y" From="-60" To="0" Duration="0:0:0.3">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="StatusInfoBar" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" />
            </Storyboard>
            <Storyboard x:Name="InfoBarSlideOut">
                <DoubleAnimation Storyboard.TargetName="InfoBarTransform" Storyboard.TargetProperty="Y" From="0" To="-60" Duration="0:0:0.25">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseIn" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="StatusInfoBar" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.25" />
            </Storyboard>
        </Grid.Resources>
        <InfoBar x:Name="StatusInfoBar" VerticalAlignment="Top" HorizontalAlignment="Center" IsOpen="False" IsClosable="False" Canvas.ZIndex="99" Opacity="0" Margin="0,2,0,0" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
            <InfoBar.RenderTransform>
                <TranslateTransform x:Name="InfoBarTransform" Y="-60"/>
            </InfoBar.RenderTransform>
        </InfoBar>

        <tabular:TableView x:Name="FeaturesTableView"
                      ItemsSource="{x:Bind FilteredItems}"
                      SelectionMode="Single"
                      IsReadOnly="True">
            <tabular:TableView.Resources>
                <Style TargetType="tabular:TableViewRow">
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="ContextFlyout">
                        <Setter.Value>
                            <MenuFlyout Opening="FeatureRowMenuFlyout_Opening">
                                <MenuFlyoutItem x:Uid="Menu_EnableFeature" Click="CmdEnable_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE73E;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                <MenuFlyoutItem x:Uid="Menu_DisableFeature" Click="CmdDisable_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE711;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                <MenuFlyoutItem x:Uid="Menu_RestoreFeature" Click="CmdRestore_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE777;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem x:Uid="Menu_CopyText" Click="CmdCopy_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                <MenuFlyoutItem x:Uid="Menu_SelectAll" Click="CmdSelectAll_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B3;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            </MenuFlyout>
                        </Setter.Value>
                    </Setter>
                </Style>
            </tabular:TableView.Resources>
                <tabular:TableViewTemplateColumn x:Name="ColIdColumn" Width="200">
                    <tabular:TableViewTemplateColumn.Header>
                        <TextBlock x:Uid="ColIdHeader" FontWeight="SemiBold" FontSize="14" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                    </tabular:TableViewTemplateColumn.Header>
                    <tabular:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="local:FeatureEntry">
                            <Grid Padding="12,4" Background="Transparent" VerticalAlignment="Stretch">
                                <Grid.ContextFlyout>
                                    <MenuFlyout Opening="FeatureRowMenuFlyout_Opening">
                                        <MenuFlyoutItem x:Uid="Menu_EnableFeature" Click="CmdEnable_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE73E;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                        <MenuFlyoutItem x:Uid="Menu_DisableFeature" Click="CmdDisable_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE711;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                        <MenuFlyoutItem x:Uid="Menu_RestoreFeature" Click="CmdRestore_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE777;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                        <MenuFlyoutSeparator/>
                                        <MenuFlyoutItem x:Uid="Menu_CopyText" Click="CmdCopy_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                        <MenuFlyoutItem x:Uid="Menu_SelectAll" Click="CmdSelectAll_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B3;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <TextBlock VerticalAlignment="Center" IsTextSelectionEnabled="True" TextWrapping="NoWrap"
                                           SelectionFlyout="{x:Null}"
                                           local:SearchHighlight.SourceText="{x:Bind Id}"
                                           local:SearchHighlight.Query="{x:Bind Query, Mode=OneWay}"
                                           local:SearchHighlight.CaseSensitive="{x:Bind CaseSensitive, Mode=OneWay}"
                                           local:SearchHighlight.IsCurrentField="{x:Bind IdIsCurrent, Mode=OneWay}"
                                           local:SearchHighlight.CurrentMatchPos="{x:Bind CurrentMatchPos, Mode=OneWay}"/>
                            </Grid>
                        </DataTemplate>
                    </tabular:TableViewTemplateColumn.CellTemplate>
                </tabular:TableViewTemplateColumn>
                <tabular:TableViewTemplateColumn x:Name="ColVariantColumn" Width="120">
                    <tabular:TableViewTemplateColumn.Header>
                        <TextBlock x:Uid="ColVariantHeader" FontWeight="SemiBold" FontSize="14" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                    </tabular:TableViewTemplateColumn.Header>
                    <tabular:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="local:FeatureEntry">
                            <Grid Padding="12,4" Background="Transparent" VerticalAlignment="Stretch">
                                <TextBlock VerticalAlignment="Center" IsTextSelectionEnabled="True" TextWrapping="NoWrap" SelectionFlyout="{x:Null}"
                                           local:SearchHighlight.SourceText="{x:Bind Variant}"
                                           local:SearchHighlight.Query="{x:Bind Query, Mode=OneWay}"
                                           local:SearchHighlight.CaseSensitive="{x:Bind CaseSensitive, Mode=OneWay}"
                                           local:SearchHighlight.IsCurrentField="{x:Bind VariantIsCurrent, Mode=OneWay}"
                                           local:SearchHighlight.CurrentMatchPos="{x:Bind CurrentMatchPos, Mode=OneWay}"/>
                            </Grid>
                        </DataTemplate>
                    </tabular:TableViewTemplateColumn.CellTemplate>
                </tabular:TableViewTemplateColumn>
                <tabular:TableViewTemplateColumn x:Name="ColDescriptionColumn" Width="*">
                    <tabular:TableViewTemplateColumn.Header>
                        <TextBlock x:Uid="ColDescriptionHeader" FontWeight="SemiBold" FontSize="14" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                    </tabular:TableViewTemplateColumn.Header>
                    <tabular:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="local:FeatureEntry">
                            <Grid Padding="12,4" Background="Transparent" VerticalAlignment="Stretch">
                                <TextBlock VerticalAlignment="Center" IsTextSelectionEnabled="True" TextWrapping="Wrap" SelectionFlyout="{x:Null}"
                                           local:SearchHighlight.SourceText="{x:Bind Description}"
                                           local:SearchHighlight.Query="{x:Bind Query, Mode=OneWay}"
                                           local:SearchHighlight.CaseSensitive="{x:Bind CaseSensitive, Mode=OneWay}"
                                           local:SearchHighlight.IsCurrentField="{x:Bind DescIsCurrent, Mode=OneWay}"
                                           local:SearchHighlight.CurrentMatchPos="{x:Bind CurrentMatchPos, Mode=OneWay}"/>
                            </Grid>
                        </DataTemplate>
                    </tabular:TableViewTemplateColumn.CellTemplate>
                </tabular:TableViewTemplateColumn>
        </tabular:TableView>
        <Border x:Name="LoadingOverlay" Grid.Row="0" Background="#66000000" Visibility="Collapsed" Canvas.ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <ProgressRing IsActive="True" Width="60" Height="60"/>
                <TextBlock x:Name="LoadingText" Text="" HorizontalAlignment="Center" FontSize="14" Opacity="0.8"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>

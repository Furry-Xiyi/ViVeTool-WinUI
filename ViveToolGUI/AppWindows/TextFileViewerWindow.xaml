<Window
    x:Class="ViVeToolGUI.AppWindows.TextFileViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ViVeToolGUI.AppWindows"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:pages="using:ViVeToolGUI.AppWindows.Pages">

    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.Resources>
            <ResourceDictionary>
                <MenuFlyout x:Name="RowContextMenu" Placement="RightEdgeAlignedTop">
                    <MenuFlyoutItem x:Name="CmdEnable" x:Uid="Menu_EnableFeature" Click="CmdEnable_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE73E;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="CmdDisable" x:Uid="Menu_DisableFeature" Click="CmdDisable_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE711;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="CmdRestore" x:Uid="Menu_RestoreFeature" Click="CmdRestore_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE777;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem x:Name="CmdCopy" x:Uid="Menu_CopyText" Click="CmdCopy_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8C8;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="CmdSelectAll" x:Uid="Menu_SelectAll" Click="CmdSelectAll_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8B3;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
                <Storyboard x:Name="ShowControlsStoryboard">
                    <DoubleAnimation Storyboard.TargetName="MatchCaseToggle" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                    <DoubleAnimation Storyboard.TargetName="NavButtonsPanel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                    <DoubleAnimation Storyboard.TargetName="MatchCaseToggleTransform" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2"/>
                    <DoubleAnimation Storyboard.TargetName="NavButtonsTransform" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2"/>
                </Storyboard>
                <Storyboard x:Name="HideControlsStoryboard">
                    <DoubleAnimation Storyboard.TargetName="MatchCaseToggle" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                    <DoubleAnimation Storyboard.TargetName="NavButtonsPanel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                    <DoubleAnimation Storyboard.TargetName="MatchCaseToggleTransform" Storyboard.TargetProperty="X" To="36" Duration="0:0:0.15"/>
                    <DoubleAnimation Storyboard.TargetName="NavButtonsTransform" Storyboard.TargetProperty="X" To="-36" Duration="0:0:0.15"/>
                </Storyboard>
            </ResourceDictionary>
        </Grid.Resources>

        <controls:TitleBar x:Name="AppTitleBar"
                           Grid.Row="0"
                           Window="{x:Bind}"
                           AutoConfigureCustomTitleBar="True"
                           DisplayMode="Tall"
                           Height="48"
                           IsBackButtonVisible="False"
                           IsPaneButtonVisible="False"
                           Background="Transparent"
                           VerticalAlignment="Stretch">
            <controls:TitleBar.Content>
            <Grid x:Name="ControlContainer" HorizontalAlignment="Center" VerticalAlignment="Center" Height="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ToggleButton x:Name="MatchCaseToggle" x:Uid="TextFileViewerWindowMatchCaseToggle" Grid.Column="0" Padding="0" Width="32" Height="32" Background="Transparent" BorderBrush="Transparent" Margin="0,0,8,0" Opacity="0" IsHitTestVisible="False" Click="MatchCaseToggle_Click">
                    <ToggleButton.RenderTransform>
                        <TranslateTransform x:Name="MatchCaseToggleTransform" X="36"/>
                    </ToggleButton.RenderTransform>
                    <FontIcon FontSize="14" Glyph="&#xE8E9;"/>
                </ToggleButton>

                <TextBox x:Name="SearchBox" x:Uid="TextFileViewerWindowSearchBox" Grid.Column="1" Width="500" CornerRadius="16" GotFocus="SearchBox_GotFocus" LostFocus="SearchBox_LostFocus" TextChanged="SearchBox_TextChanged"/>

                <StackPanel x:Name="NavButtonsPanel" Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0" Opacity="0" IsHitTestVisible="False">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="NavButtonsTransform" X="-36"/>
                    </StackPanel.RenderTransform>
                    <Button x:Name="PrevButton" x:Uid="TextFileViewerWindowPrevButton" Padding="0" Width="32" Height="32" Background="Transparent" Style="{StaticResource ButtonRevealStyle}" Click="PrevButton_Click">
                        <FontIcon FontSize="14" Glyph="&#xE74A;"/>
                    </Button>
                    <Button x:Name="NextButton" x:Uid="TextFileViewerWindowNextButton" Padding="0" Width="32" Height="32" Background="Transparent" Style="{StaticResource ButtonRevealStyle}" Click="NextButton_Click">
                        <FontIcon FontSize="14" Glyph="&#xE74B;"/>
                    </Button>
                    <TextBlock x:Name="MatchCountText" VerticalAlignment="Center" Margin="6,0,0,0" MinWidth="36"
               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <Button x:Name="RefreshButton" x:Uid="RefreshButton" Grid.Column="3" Padding="0" Width="32" Height="32" Background="Transparent" Style="{StaticResource ButtonRevealStyle}" Margin="4,0,0,0" Visibility="Collapsed" VerticalAlignment="Center" Click="RefreshButton_Click">
                    <FontIcon x:Name="RefreshIcon" FontSize="14" Glyph="&#xE72C;">
                        <FontIcon.RenderTransform>
                            <RotateTransform x:Name="RefreshIconRotation" CenterX="7" CenterY="7"/>
                        </FontIcon.RenderTransform>
                    </FontIcon>
                </Button>
            </Grid>
            </controls:TitleBar.Content>
        </controls:TitleBar>

        <pages:TextFileViewerPage x:Name="ViewerPage" Grid.Row="1" />
    </Grid>
</Window>

<Window
    x:Class="ViVeToolGUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <Grid>
        <Button x:Name="BackButton"
                x:Uid="BackButton"
                VerticalAlignment="Top" HorizontalAlignment="Left"
                Margin="8,8,8,8"
                Height="32"
                Width="32"
                Style="{ThemeResource TitleBarBackButtonStyle}"
                Visibility="Collapsed"
                Click="BackButton_Click"
                Canvas.ZIndex="1"/>

        <controls:TitleBar x:Name="TitleBarArea"
                            Window="{x:Bind}"
                            AutoConfigureCustomTitleBar="True"
                            VerticalAlignment="Top"
                            Height="48"
                            DisplayMode="Tall"
                            IsBackButtonVisible="False"
                            IsPaneButtonVisible="False"
                            Background="Transparent"
                            Canvas.ZIndex="0"/>

        <Grid x:Name="NavViewContainer" Margin="0,48,0,0" Canvas.ZIndex="0">
            <NavigationView x:Name="NavView"
                            PaneDisplayMode="LeftCompact"
                            IsSettingsVisible="True"
                            IsBackButtonVisible="Collapsed"
                            IsPaneToggleButtonVisible="False"
                            ItemInvoked="NavView_ItemInvoked"
                            Style="{StaticResource NavigationViewStoreStyle}">

                <NavigationView.MenuItems>
                    <NavigationViewItem x:Name="EnableDisableNavItem" x:Uid="Nav_EnableDisable" Tag="enableDisable">
                        <NavigationViewItem.Icon>
                            <FontIcon x:Name="EnableDisableIcon" Glyph="&#xE90F;" FontSize="18" FontWeight="SemiBold"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="QueryNavItem" x:Uid="Nav_Query" Tag="query">
                        <NavigationViewItem.Icon>
                            <FontIcon x:Name="QueryIcon" Glyph="&#xE721;" FontSize="18" FontWeight="SemiBold"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="ResetNavItem" x:Uid="Nav_Reset" Tag="reset">
                        <NavigationViewItem.Icon>
                            <FontIcon x:Name="ResetIcon" Glyph="&#xE777;" FontSize="18" FontWeight="SemiBold"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>
                <NavigationView.FooterMenuItems>
                    <Frame x:Name="MainFrame">
                    </Frame>
                </NavigationView.FooterMenuItems>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="BreadcrumbPanel"
                                Grid.Row="0"
                                Orientation="Horizontal"
                                Spacing="4"
                                Padding="20,16,20,0"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <BreadcrumbBar x:Name="BreadcrumbNav"
                                       ItemsSource="{x:Bind BreadcrumbItems, Mode=OneWay}">
                            <BreadcrumbBar.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               FontSize="28"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource SubtitleTextBlockStyle}"/>
                                </DataTemplate>
                            </BreadcrumbBar.ItemTemplate>
                        </BreadcrumbBar>
                    </StackPanel>
                    <Frame x:Name="ContentFrame" Grid.Row="1">
                        <Frame.ContentTransitions>
                            <TransitionCollection>
                                <NavigationThemeTransition />
                            </TransitionCollection>
                        </Frame.ContentTransitions>
                    </Frame>
                </Grid>
            </NavigationView>
        </Grid>

        <Border x:Name="CommonLoadingOverlay" Background="#66000000" Visibility="Collapsed" Canvas.ZIndex="10">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <ProgressRing IsActive="True" Width="60" Height="60"/>
                <TextBlock x:Name="CommonLoadingText" Text="Loading..." HorizontalAlignment="Center" FontSize="14" Opacity="0.8"/>
            </StackPanel>
        </Border>

        <Grid x:Name="SplashOverlay" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Visibility="Visible" Opacity="1" Canvas.ZIndex="30">
            <Grid.Resources>
                <Storyboard x:Name="SplashFadeOut">
                    <DoubleAnimation Storyboard.TargetName="SplashOverlay" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.15">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseIn"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </Grid.Resources>
            <Image Source="ms-appx:///Assets/SplashScreen.png" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="None"/>
        </Grid>
    </Grid>
</Window>
